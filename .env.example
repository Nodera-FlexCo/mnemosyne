# Copy to .env on the box. Secrets are generated there with `make secrets`
# (openssl) so they never leave the server. Never commit .env.

POSTGRES_DB=mnemosyne
POSTGRES_USER=mnemo
POSTGRES_PASSWORD=__generate_on_box__
REDIS_PASSWORD=__generate_on_box__

# --- Langfuse v2 (eval plane) — secrets generated on box by `make secrets` ---
LANGFUSE_DB=langfuse
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=__generate_on_box__
LANGFUSE_SALT=__generate_on_box__
LANGFUSE_ENCRYPTION_KEY=__generate_on_box__          # openssl rand -hex 32 (64 hex chars)
LANGFUSE_INIT_ORG_ID=mnemosyne
LANGFUSE_INIT_PROJECT_ID=nodex-evals
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-__generate_on_box__
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-__generate_on_box__
LANGFUSE_INIT_USER_EMAIL=dev@nodera.studio
LANGFUSE_INIT_USER_PASSWORD=__generate_on_box__
LANGFUSE_INIT_USER_NAME=Mnemosyne

# --- Remote MCP connector (Cloudflare Tunnel) ---
# Your Cloudflare-delegated zone. Public hostnames derive from it:
#   memory.${DOMAIN}, codebase.${DOMAIN}, (Phase 2) auth.${DOMAIN}
DOMAIN=example.com
# Set COMPOSE_PROFILES=edge to bring cloudflared (and Phase-2 mnemo-auth) up.
COMPOSE_PROFILES=
# Tunnel auth — token mode. Create a named tunnel (CF dashboard / API), set its run token here.
# Ingress is managed remotely via the CF API (memory+codebase only, no secrets route).
TUNNEL_TOKEN=__set_on_box__

# --- Origin allowlist (DNS-rebinding guard on memory/codebase) ---
PUBLIC_ORIGIN=https://memory.example.com
ALLOWED_ORIGINS=https://memory.example.com,https://codebase.example.com

# --- Phase 1: Cloudflare Access Managed-OAuth probe (only if you take the CF Access path) ---
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=__set_on_box__

# --- Phase 2: self-hosted OAuth 2.1 AS (only if the CF Access probe fails) ---
MNEMO_OAUTH_ISSUER=https://auth.example.com
OAUTH_DB_SCHEMA=oauth
